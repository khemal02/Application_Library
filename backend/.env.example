NODE_ENV=development
PORT=5000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=aams
DB_USER=aams
DB_PASSWORD=replace_with_the_aams_role_password

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

CORS_ORIGIN=http://localhost:5173

LOG_LEVEL=info

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# Storage driver: "local" for now, swappable for "s3" later (see src/modules/attachments/storage.js)
STORAGE_DRIVER=local
